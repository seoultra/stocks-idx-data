    "raw_base": "https://raw.githubusercontent.com/seoultra/stocks-idx-data/main/",
    "data_through": "2026-09-30",
    "prices_through": "2026-11-02",
    "units": {
        "money": "IDR billion",
        "per_share": "IDR per share as printed (raw) — apply splits from corporate_actions.json using each value's share_basis",
        "shares": "whole shares",
        "price": "IDR per share AS TRADED in prices/*.json — divide by each split factor in the file's `splits` for rows dated before its ex_date",
        "volume": "shares traded in the regular market session",
        "ratio": "percent (23.9 = 23.9%)",
        "date": "YYYY-MM-DD"
    },
    "files": {
        "sectors": "sectors.json",
        "corporate_actions": "corporate_actions.json",
        "macro": "macro.json",
        "prices": "prices/{CODE}.json",
        "validation_report": "validation_report.json",
        "schema": "SCHEMA.md"
    },
