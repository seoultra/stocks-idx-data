{
    "schema": 1,
    "name": "IDX stock fundamentals",
    "description": "Source-backed fundamentals (FY2020 onward plus the latest quarter), dividends, corporate actions and end-of-day daily prices for banks listed on the Indonesia Stock Exchange. Every fundamental number carries its source document, source type, as-of date and page; prices carry their source per file. Not investment advice.",
    "publisher": {
        "name": "Jarot AI",
        "parent_organization": "SEOULTRA",
        "url": "https://seoultra.id/stocks/idx/"
    },
